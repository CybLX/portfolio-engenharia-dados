digraph G {
graph [rankdir=TB, bgcolor="transparent", pad="0.4", nodesep="0.45", ranksep="0.7", splines=polyline, fontname="Arial", outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fontname="Arial", fontsize=15, fontcolor="#102B44", color="#BFCFE1", penwidth=1.2, margin="0.24,0.17"];
edge [fontname="Arial", fontsize=12, fontcolor="#34516D", color="#496C95", arrowsize=0.7, penwidth=1.2];
events [label="Pub/Sub:\neventos compartilhados de status", fillcolor="#D5F0FA"];
boundary [label="Consumidor compartilhado de status:\nfora da exportação", fillcolor="#FFFFFF"];
bq [label="BigQuery:\nvisões de relatórios operacionais", fillcolor="#EDF2F8"];
schedule [label="Cloud Scheduler", fillcolor="#EEF1FC"];
report [label="Cloud Functions:\ngeração de relatórios", fillcolor="#E7EFFF"];
drive [label="Google Drive:\nrelatórios CSV", fillcolor="#FFFFFF"];
monitor [label="Cloud Functions:\nmonitor operacional", fillcolor="#E7EFFF"];
metrics [label="Cloud Monitoring:\nmétricas do Pub/Sub", fillcolor="#EEF1FC"];
chat [label="Google Chat:\nnotificações", fillcolor="#FFFFFF"];
events -> boundary [label="contrato de integração de status", style=dashed, color="#788795", fontcolor="#526477"];
boundary -> bq [label="implementação da persistência não fornecida", style=dashed, color="#788795", fontcolor="#526477"];
schedule -> report [label="HTTP agendado", style=dashed];
bq -> report [label="resultados de consultas", style=solid];
report -> drive [label="publicação de CSV", style=solid];
schedule -> monitor [label="HTTP agendado", style=dashed];
metrics -> monitor [label="volume pendente e idade das mensagens", style=solid];
bq -> monitor [label="atividade mais recente dos processadores", style=solid];
monitor -> chat [label="resumo de status", style=solid];
}