flowchart TD
    build["Cloud Build"]
    registry["Artifact Registry"]
    run["Cloud Run: conversor"]
    functions["Cloud Functions: serviços HTTP"]
    config["Cloud Storage: configuração"]
    iam["IAM: contas de serviço e OIDC"]
    secrets["Secret Manager"]
    admin["Script administrativo de implantação"]
    iap["IAP: túnel documentado"]
    vm["Compute Engine: processadores"]
