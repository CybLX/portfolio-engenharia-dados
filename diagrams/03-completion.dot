digraph G {
graph [rankdir=TB, bgcolor="transparent", pad="0.4", nodesep="0.45", ranksep="0.7", splines=polyline, fontname="Arial", outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fontname="Arial", fontsize=15, fontcolor="#102B44", color="#BFCFE1", penwidth=1.2, margin="0.24,0.17"];
edge [fontname="Arial", fontsize=12, fontcolor="#34516D", color="#496C95", arrowsize=0.7, penwidth=1.2];
vm [label="Compute Engine:\nprocessadores de navegador", fillcolor="#DAE6FF"];
done [label="Pub/Sub:\neventos de conclusão", fillcolor="#D5F0FA"];
final [label="Cloud Functions:\nfinalizador", fillcolor="#E7EFFF"];
store [label="Cloud Storage:\nplanilhas parciais e finais", fillcolor="#EDF2F8"];
transfer [label="Pub/Sub:\ntarefas de transferência de arquivos", fillcolor="#D5F0FA"];
sender [label="Cloud Functions:\nentrega ao Drive", fillcolor="#E7EFFF"];
drive [label="Google Drive:\narquivos de saída", fillcolor="#FFFFFF"];
api [label="API de controle de solicitações", fillcolor="#FFFFFF"];
status [label="Pub/Sub:\neventos compartilhados de status", fillcolor="#D5F0FA"];
ack [label="Falha tratada:\nstatus e confirmação", fillcolor="#EEF1FC"];
vm -> done [label="resultados de criação e regularização", style=solid];
done -> final [label="envio HTTP", style=solid];
store -> final [label="ler estado da planilha", style=solid];
final -> store [label="gravar resultados dos lotes", style=solid];
final -> transfer [label="arquivos concluídos ou para correção", style=solid];
transfer -> sender [label="envio HTTP", style=solid];
sender -> drive [label="entregar arquivos", style=solid];
final -> api [label="solicitar encerramento", style=dashed];
vm -> status [label="status da operação", style=solid];
final -> status [label="status da finalização", style=solid];
vm -> ack [label="caminho de exceção", style=dashed];
final -> ack [label="erros tratados e inesperados", style=dashed];
}