digraph G {
graph [rankdir=TB, bgcolor="transparent", pad="0.4", nodesep="0.45", ranksep="0.7", splines=polyline, fontname="Arial", outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fontname="Arial", fontsize=15, fontcolor="#102B44", color="#BFCFE1", penwidth=1.2, margin="0.24,0.17"];
edge [fontname="Arial", fontsize=12, fontcolor="#34516D", color="#496C95", arrowsize=0.7, penwidth=1.2];
schedule [label="Cloud Scheduler", fillcolor="#EEF1FC"];
intake [label="Cloud Functions:\ningestão", fillcolor="#E7EFFF"];
api [label="API de controle de solicitações", fillcolor="#FFFFFF"];
store [label="Cloud Storage:\npontos de controle e artefatos", fillcolor="#EDF2F8"];
incoming [label="Pub/Sub:\nsolicitações recebidas", fillcolor="#D5F0FA"];
validate [label="Cloud Functions:\nvalidação", fillcolor="#E7EFFF"];
work [label="Pub/Sub:\nfilas de operações", fillcolor="#D5F0FA"];
vm [label="Compute Engine:\nprocessadores de navegador", fillcolor="#DAE6FF"];
erp [label="Plataforma corporativa de compras", fillcolor="#FFFFFF"];
schedule -> intake [label="HTTP agendado", style=dashed];
intake -> store [label="ler e avançar marcador", style=solid];
intake -> api [label="solicitar janela de tempo", style=dashed];
api -> incoming [label="contrato de entrega solicitado", style=dashed, color="#788795", fontcolor="#526477"];
incoming -> validate [label="conteúdo enviado por HTTP", style=solid];
validate -> store [label="estado dos documentos", style=solid];
validate -> work [label="conteúdo validado da operação", style=solid];
work -> vm [label="busca e roteamento por conta", style=solid];
vm -> erp [label="ações no navegador", style=dashed];
}